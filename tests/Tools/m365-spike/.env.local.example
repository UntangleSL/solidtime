# Con Doppler no hace falta este fichero: ejecute la herramienta con
#   doppler run -p vps -c dev -- node tests/Tools/m365-spike/capture.mjs <comando>
# y use los nombres SOLIDTIME_* de Doppler (si un nombre M365_* no está definido, se lee el de
# Doppler: SOLIDTIME_MICROSOFT_TENANT_ID, SOLIDTIME_MICROSOFT_CLIENT_ID,
# SOLIDTIME_M365_SPIKE_CLIENT_SECRET y SOLIDTIME_M365_SPIKE_<resto del nombre>).
# With Doppler this file is not needed: run the tool with the command above and keep the values in
# the SOLIDTIME_* Doppler keys. When an M365_* name is unset, the Doppler name is read instead.
# NUNCA ponga SOLIDTIME_MICROSOFT_CLIENT_SECRET (producción) en dev ni aquí: la herramienta se
# niega a ejecutarse / NEVER put SOLIDTIME_MICROSOFT_CLIENT_SECRET (production) in dev or here:
# the tool refuses to run.
#
# Sin Doppler, copie este fichero a tests/Tools/m365-spike/.env.local y rellene los valores.
# Without Doppler, copy this file to tests/Tools/m365-spike/.env.local and fill in the values.
# .env.local is git-ignored. Never paste its contents into a chat or an AI assistant.

# Directory (tenant) ID of the Untangle tenant: the GUID, never "common" or "organizations".
M365_TENANT_ID=

# Application (client) ID of the app registration.
M365_CLIENT_ID=

# Solo el secreto "spike-*" (columna Valor), nunca el secreto de producción.
# Only the temporary "spike-*" secret (the Value column), never the production secret.
M365_CLIENT_SECRET=

# Usuaria de prueba A (la propietaria, Administradora global): e-mail / UPN que debe iniciar sesión.
# Test user A (the owner, Global Administrator): the e-mail / UPN that must sign in.
M365_SPIKE_LOGIN_HINT=

# Usuaria B (Alejandro Cava: sin rol de administrador, no asignada a la aplicación), para "auth --as B".
# Test user B (Alejandro Cava: no admin role, not assigned to the app), for "auth --as B".
# (El antiguo M365_SPIKE_BLOCKED_LOGIN_HINT se sigue leyendo, pero está obsoleto.)
M365_SPIKE_B_LOGIN_HINT=

# Ventana de captura, ISO-8601 en UTC con Z, como máximo 62 días / capture window, UTC, max 62 days.
# Por defecto / default: 2026-10-19T00:00:00Z -> 2026-11-16T00:00:00Z
# Alternativa de marzo / March alternative: 2027-03-22T00:00:00Z -> 2027-04-19T00:00:00Z
M365_SPIKE_WINDOW_START=
M365_SPIKE_WINDOW_END=

# Cliente de Outlook usado para crear los escenarios / Outlook client used to create the
# scenarios: one of web, new, classic.
M365_SPIKE_OUTLOOK_CLIENT=

# Puerto del receptor local (por defecto 8765) / local callback port (default 8765).
# La app registra http://localhost/m365-spike/callback; Entra ignora el puerto en localhost.
M365_SPIKE_PORT=
